{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "jsxSingleQuote": true,
  "printWidth": 80,
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    ".expo",
    "android",
    "ios",
    "build",
    "dist",
    "bun.lock",
    "training-harness/data",
    "training-harness/.venv",
    "**/*.mlmodelc",
    "app/modules/*/eval-*.json"
  ]
}
